{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.arizonahouseoffilm.com" }],
      "destination": "https://arizonahouseoffilm.com/:path*",
      "permanent": true
    },
    { "source": "/dealeriframe/:path*", "destination": "/films", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/index.php/:path*", "destination": "/", "permanent": true },
    { "source": "/lander", "destination": "/", "permanent": true },
    { "source": "/lander/:path*", "destination": "/", "permanent": true },
    { "source": "/commercial", "destination": "/commercial-window-tinting", "permanent": true },
    { "source": "/residential", "destination": "/residential-window-tinting", "permanent": true },
    { "source": "/decorative", "destination": "/decorative-window-films", "permanent": true },
    { "source": "/energy-saving", "destination": "/energy-saving-window-films", "permanent": true },
    { "source": "/safety-film", "destination": "/safety", "permanent": true },
    { "source": "/anti-graffiti-film", "destination": "/anti-graffiti", "permanent": true },
    { "source": "/anti-graffiti-window-film", "destination": "/anti-graffiti", "permanent": true },
    { "source": "/services/anti-graffiti", "destination": "/anti-graffiti", "permanent": true },
    { "source": "/phoenix-window-tinting", "destination": "/service-areas/phoenix", "permanent": true },
    { "source": "/chandler-window-tinting", "destination": "/service-areas/chandler", "permanent": true },
    { "source": "/glendale-window-tinting", "destination": "/service-areas/glendale", "permanent": true },
    { "source": "/mesa-window-tinting", "destination": "/service-areas/mesa", "permanent": true },
    { "source": "/scottsdale-window-tinting", "destination": "/service-areas/scottsdale", "permanent": true },
    { "source": "/tucson-window-tinting", "destination": "/service-areas/tucson", "permanent": true },
    { "source": "/films/specialty-films/solar", "destination": "/energy-saving-window-films", "permanent": true },
    { "source": "/films/specialty-films/ultracool", "destination": "/energy-saving-window-films", "permanent": true },
    { "source": "/films/specialty-films/temporary", "destination": "/decorative-window-films", "permanent": true },
    { "source": "/commercial-window-tinting/uv-protection", "destination": "/commercial-window-tinting", "permanent": true },
    { "source": "/pages/", "destination": "/", "permanent": true },
    { "source": "/pages", "destination": "/", "permanent": true },
    { "source": "/welcome/wp-admin/admin-ajax.php", "destination": "/", "permanent": true },
    { "source": "/welcome/careers/", "destination": "/careers", "permanent": true },
    { "source": "/welcome/careers", "destination": "/careers", "permanent": true },
    { "source": "/welcome/gallery/", "destination": "/gallery", "permanent": true },
    { "source": "/welcome/gallery", "destination": "/gallery", "permanent": true },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/sv/", "destination": "/", "permanent": true },
    { "source": "/sv", "destination": "/", "permanent": true },
    { "source": "/welcome/:path*", "destination": "/", "permanent": true },
    { "source": "/services/privacy", "destination": "/residential-window-tinting", "permanent": true },
    { "source": "/benson-window-tinting", "destination": "/service-areas/benson", "permanent": true },
    { "source": "/residential-window-tinting/temperature-control", "destination": "/residential-window-tinting", "permanent": true },
    { "source": "/fountain-hills-window-tinting", "destination": "/service-areas/fountain-hills", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
